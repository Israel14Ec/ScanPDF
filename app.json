{
  "expo": {
    "name": "Mi Escáner PDF",
    "slug": "mi-escaner-pdf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/scanner-icon.png",
    "scheme": "miescanerpdf",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/scanner-adaptive.png",
        "backgroundColor": "#245FE5"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.miescanerpdf.app",
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "mimeType": "application/pdf",
              "scheme": "content"
            },
            {
              "mimeType": "application/pdf",
              "scheme": "file"
            }
          ],
          "autoVerify": false,
          "action": "VIEW"
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withWindowsCpp.cjs",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7FC",
          "image": "./assets/images/scanner-icon.png",
          "imageWidth": 100
        }
      ],
      "react-native-blob-util",
      [
        "expo-sharing",
        {
          "android": {
            "multipleShareMimeTypes": [],
            "singleShareMimeTypes": ["application/pdf"],
            "enabled": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": ["android"]
  }
}
